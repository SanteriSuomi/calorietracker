# Drizzle
DATABASE_URL=file:local.db
# For Docker: use file:data/local.db to persist DB in the named volume
DATABASE_PROVIDER=libsql

# Required in production (e.g. https://calorietracker.example.com).
# Auto-detected in dev from the Vite dev server port.
ORIGIN=

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Dev seed — run `pnpm seed:dev` to create test user (test@gmail.com / Password1)
# DEV_SEED=true

# Image storage
STORAGE_PROVIDER=local
ENCRYPTION_SECRET=
AZURE_BLOB_CONNECTION_STRING=

# Email (Nodemailer)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Resend free tier only allows sending from onboarding@resend.dev.
# Verify a custom domain in Resend dashboard to use your own sender.
EMAIL_FROM=onboarding@resend.dev

# Logging
LOG_LEVEL=info

# Auth bypass (MiniPC only — hard-fails if AZURE_DEPLOYMENT=true)
DISABLE_AUTH=false

# Azure deployment flag (set on Container Apps, never on MiniPC)
AZURE_DEPLOYMENT=false

# AI defaults (fallbacks when user hasn't configured their own)
AI_DEFAULT_ENDPOINT=
AI_DEFAULT_API_KEY=
AI_DEFAULT_MODEL=
