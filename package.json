{
	"name": "calorietracker",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"lint": "biome check .",
		"format": "biome check --write .",
		"db:push": "drizzle-kit push",
		"db:push:pg": "drizzle-kit push --config=drizzle-pg.config.ts",
		"db:generate": "drizzle-kit generate",
		"db:generate:pg": "drizzle-kit generate --config=drizzle-pg.config.ts",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:pg": "drizzle-kit migrate --config=drizzle-pg.config.ts",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "better-auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"seed:dev": "tsx scripts/seed-dev.ts",
		"docker:build": "docker compose build",
		"docker:up": "docker compose -f docker-compose.yml up -d",
		"docker:down": "docker compose down",
		"docker:dev": "docker compose up",
		"docker:dev:pg": "docker compose --profile pg up"
	},
	"devDependencies": {
		"@better-auth/cli": "1.4.21",
		"@biomejs/biome": "2.4.11",
		"@fontsource-variable/inter": "^5.2.8",
		"@inlang/paraglide-js": "^2.18.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.8.0",
		"@sveltejs/adapter-node": "5.5.4",
		"@sveltejs/kit": "2.60.1",
		"@sveltejs/vite-plugin-svelte": "7.0.0",
		"@tailwindcss/vite": "4.2.2",
		"@types/node": "24.0.1",
		"@types/nodemailer": "6.4.17",
		"@types/pg": "8.20.0",
		"@vitest/browser-playwright": "4.1.4",
		"better-auth": "1.4.21",
		"clsx": "^2.1.1",
		"drizzle-kit": "0.31.10",
		"drizzle-orm": "0.45.2",
		"pino-pretty": "13.1.3",
		"playwright": "1.59.1",
		"pm2": "^6.0.14",
		"shadcn-svelte": "^1.2.7",
		"svelte": "5.55.3",
		"svelte-check": "4.4.6",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.2",
		"vite": "8.0.7",
		"vitest": "4.1.4",
		"vitest-browser-svelte": "2.1.0"
	},
	"dependencies": {
		"@ai-sdk/openai": "3.0.52",
		"@azure/storage-blob": "^12.31.0",
		"@libsql/client": "0.17.2",
		"ai": "6.0.158",
		"bits-ui": "^2.17.3",
		"chart.js": "4.5.1",
		"nodemailer": "8.0.5",
		"pg": "8.20.0",
		"pino": "10.3.1",
		"zod": "^4.4.1"
	}
}
